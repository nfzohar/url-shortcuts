{
  "manifest_version": 3,
  "name": "URL Shortcuts",
  "description": "Setup custom keyboard shortcuts to open URLs.",
  "author": "nfzohar",
  "version": "1.0",
  "action": {
    "default_title": "Manage your URL shortcuts"
  },
  "icons": {
    "16": "res/icon/16x16.png",
    "32": "res/icon/32x32.png",
    "48": "res/icon/48x48.png",
    "64": "res/icon/64x64.png",
    "128": "res/icon/128x128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "res/clickHandler.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["res/content/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "res/content/js/defineShortcutService.js",
        "res/content/js/helpers/buildFormAddNew.js",
        "res/content/js/helpers/manageLocalStorage.js",
        "res/content/js/helpers/buildShortcutsList.js",
        "res/content/js/helpers/defineEventListeners.js"
      ],
      "css": [
        "res/content/css/main.css",
        "res/content/css/form.css",
        "res/content/css/shortcuts.css"
      ],
      "match_origin_as_fallback": false,
      "match_about_blank": false,
      "all_frames": false,
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
