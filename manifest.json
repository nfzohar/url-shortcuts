{
  "manifest_version": 3,
  "name": "URL Shortcuts",
  "description": "Setup custom keyboard shortcuts to open URLs.",
  "author": "nfzohar",
  "version": "2.0",
  "action": {
    "default_title": "Manage your URL shortcuts"
  },
  "icons": {
    "16": "res/icon/16x16.png",
    "32": "res/icon/32x32.png",
    "48": "res/icon/48x48.png",
    "64": "res/icon/64x64.png",
    "128": "res/icon/128x128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "res/background.js",
    "scripts": ["res/background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "url-shortcuts@nfzohar",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["res/keys.js", "res/shortcuts.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["res/content/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
